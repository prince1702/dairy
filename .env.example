# Database connection string.
# For local development with SQLite: file:./dev.db
DATABASE_URL=

# NextAuth.js secret key used to sign/encrypt JWTs and session tokens.
# Generate a strong secret with: openssl rand -base64 32
# This MUST be set before running the app. The app will throw a startup error if missing.
NEXTAUTH_SECRET=

# The canonical URL of your deployment (no trailing slash).
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000

# If unset, payment screenshot uploads will fall back to a simulated mock URL — see src/lib/upload.ts
CLOUDINARY_URL=

CLOUDINARY_UPLOAD_PRESET=
